{
  "mcpServers": {
    "atlassian-rovo": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_API_KEY:-}"
      }
    },
    "gitlab": {
      "type": "http",
      "url": "https://biosphere.teamsystem.com/api/v4/mcp"
    }
  }
}
