+import type { Page, Request } from '@playwright/test'
+import { expect, test } from '../../fixtures'
+
+// FIC-13378 — [FE] Activate multi warehouse feature flow  (Task, status "Merged in MB")
+// https://teamsystem.atlassian.net/browse/FIC-13378
+//
+// The ticket has no acceptance criteria (description is only a Figma link) and no feature
+// label, so the behaviour below is taken from the MERGED code change, not the ticket text.
+// Merge commit 8039afd, files under src/features/warehouseManagement/hooks/:
+//
+//   useArchiveWarehouse:  before  PUT   warehouse/{id}/workspace/{ws}   body { isArchive: true }
+//                         after   PATCH warehouse/{id}/workspace/{ws}/archive    (no body)
+//   useRestoreWarehouse:  before  PUT   warehouse/{id}/workspace/{ws}   body { isArchive: false }
+//                         after   PATCH warehouse/{id}/workspace/{ws}/activate   (no body)
+//
+// Both tests are pending (test.fixme). The multi-warehouse management screen is not one of the
+// four routes this harness knows, and the ticket gives no page route or button labels, so the
+// UI that triggers archive/restore cannot be driven yet. The endpoint contract from the diff is
+// recorded here so a developer or QA can add the navigation + button selectors and drop `.fixme`.
+// Nothing about the UI is invented.
+
+// Record every call the app makes to the warehouse write endpoints, so a test can assert the
+// method and path the archive/restore action actually used.
+async function recordWarehouseWrites(page: Page): Promise<Request[]> {
+  const calls: Request[] = []
+  await page.route('**/warehouse/*/workspace/**', route => {
+    calls.push(route.request())
+    route.fulfill({ status: 200, json: {} })
+  })
+  return calls
+}
+
+test.describe('FIC-13378 — multi-warehouse archive/restore use the new PATCH endpoints', () => {
+  // Scenario: Archiving a warehouse calls PATCH .../archive (not the old PUT with a body)
+  //   Given the multi-warehouse management screen with at least one active warehouse
+  //   When I archive that warehouse
+  //   Then the app sends PATCH warehouse/{id}/workspace/{ws}/archive
+  //   And it does NOT send the old PUT warehouse/{id}/workspace/{ws} with { isArchive: true }
+  test.fixme(
+    'FIC-13378-1-archive-warehouse-uses-patch-archive',
+    async ({ page, warehouse }) => {
+      const calls = await recordWarehouseWrites(page)
+      // TODO(QA): navigate to the multi-warehouse management route (unknown — not on the ticket).
+      await warehouse.goto('/warehouse-management')
+      // TODO(QA): click the archive action for a warehouse (button label unknown — not on the ticket).
+
+      await expect
+        .poll(() => calls.map(c => `${c.method()} ${new URL(c.url()).pathname}`))
+        .toContainEqual(expect.stringMatching(/^PATCH .*\/workspace\/.*\/archive$/))
+      expect(
+        calls.some(c => c.method() === 'PUT' && /\/isArchive/.test(c.postData() ?? ''))
+      ).toBe(false)
+    }
+  )
+
+  // Scenario: Restoring a warehouse calls PATCH .../activate (not the old PUT with a body)
+  //   Given the multi-warehouse management screen with at least one archived warehouse
+  //   When I restore that warehouse
+  //   Then the app sends PATCH warehouse/{id}/workspace/{ws}/activate
+  //   And it does NOT send the old PUT warehouse/{id}/workspace/{ws} with { isArchive: false }
+  test.fixme(
+    'FIC-13378-2-restore-warehouse-uses-patch-activate',
+    async ({ page, warehouse }) => {
+      const calls = await recordWarehouseWrites(page)
+      // TODO(QA): navigate to the multi-warehouse management route (unknown — not on the ticket).
+      await warehouse.goto('/warehouse-management')
+      // TODO(QA): click the restore action for an archived warehouse (button label unknown).
+
+      await expect
+        .poll(() => calls.map(c => `${c.method()} ${new URL(c.url()).pathname}`))
+        .toContainEqual(expect.stringMatching(/^PATCH .*\/workspace\/.*\/activate$/))
+      expect(
+        calls.some(c => c.method() === 'PUT' && /\/isArchive/.test(c.postData() ?? ''))
+      ).toBe(false)
+    }
+  )
+})
