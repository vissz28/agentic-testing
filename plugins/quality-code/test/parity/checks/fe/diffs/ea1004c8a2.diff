+import { expect, test, WORKSPACE_ID } from '../../fixtures'
+
+/**
+ * The check on e2e/backend-up.sh: proves a spec can reach the real warehouse-read service
+ * instead of a page.route stub. Unlike products-stock.smoke.spec.ts, this one registers no
+ * feature-data routes, so /trade-items goes out over the wire.
+ *
+ * Run with: npm run e2e:live  (plain `npm run e2e` skips it — no backend is started).
+ *
+ * Asserts the round-trip, not the rows: the DB is empty unless someone seeded it, and an
+ * empty 200 still proves the request left the browser and a real service answered.
+ */
+test('products-stock reads from the real backend, not a stub', async ({
+  page,
+  warehouse,
+}) => {
+  test.skip(
+    !process.env.E2E_BACKEND,
+    'needs the real backend — run `npm run e2e:live`'
+  )
+
+  const tradeItems = page.waitForResponse(
+    response =>
+      response.url().includes(`/trade-items/workspace/${WORKSPACE_ID}`) &&
+      response.request().method() === 'GET',
+    { timeout: 30_000 }
+  )
+
+  await warehouse.goto('/products-stock')
+
+  const response = await tradeItems
+  // Port 3010 is warehouse-read. A stubbed response would never carry it.
+  expect(new URL(response.url()).port).toBe('3010')
+  expect(response.status()).toBe(200)
+  // 200 rather than 404 also means the workspace row backend-up.sh inserted took effect.
+  await expect(page.locator('.MuiDataGrid-root')).toBeVisible({
+    timeout: 15_000,
+  })
+})
