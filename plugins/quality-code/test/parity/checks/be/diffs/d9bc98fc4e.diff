-  });
-
-  beforeEach(async () => {
-    await db.restore();
-    repo = new KpiRepository(db.prisma());
-  });
-
-  // Regression anchor: RED on current source (returns the stale 50 instead of 0).
-  it("getLastUnitCost: a provided cost of 0 is recorded, not the previous KPI's last_cost=50", async () => {
-    const prisma = db.prisma();
-    await seedTradeItem(prisma);
-    await seedKpi(prisma, { lastCost: "50" });
-
-    const result = await repo.getLastUnitCost(kpiData, 0);
-
-    expect(result).toBe(0);
-    expect(result).not.toBe(50);
-  });
-
-  it("getLastUnitCost: a provided non-zero cost (80) is used over last_cost=50", async () => {
-    const prisma = db.prisma();
-    await seedTradeItem(prisma);
-    await seedKpi(prisma, { lastCost: "50" });
-
-    const result = await repo.getLastUnitCost(kpiData, 80);
-
-    expect(result).toBe(80);
-  });
-
-  it("getLastUnitCost: no provided cost falls back to the last KPI's last_cost=50", async () => {
-    const prisma = db.prisma();
-    await seedTradeItem(prisma);
-    await seedKpi(prisma, { lastCost: "50" });
-
-    const result = await repo.getLastUnitCost(kpiData);
-
-    expect(result).toBe(50);
-  });
-
-  // Twin anchor: RED on current source (returns the stale 30 instead of 0).
-  it("getLastUnitPrice: a provided price of 0 is recorded, not the previous KPI's last_price=30", async () => {
-    const prisma = db.prisma();
-    await seedTradeItem(prisma);
-    await seedKpi(prisma, { lastPrice: "30" });
-
-    const result = await repo.getLastUnitPrice(kpiData, 0);
-
-    expect(result).toBe(0);
-    expect(result).not.toBe(30);
