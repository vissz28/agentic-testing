+import { describe, it, expect, beforeAll, beforeEach, vi } from "vitest";
+import * as XLSX from "xlsx";
+import { ImportAdjustmentReportGenerationService } from "@app/common/services/import-adjustment-report/import-adjustment-report-generation.service";
+import { ImportAdjustmentReportService } from "@app/common/services/import-adjustment-report/import-adjustment-report.service";
+import { ImportAdjustmentReportRepository } from "@app/common/repositories/import-adjustment-report.repository";
+import { ReportType } from "@prisma-client";
+import { startLiveDb, type LiveDb } from "@test/postgres.container";
+import { IA, WS, seedImportAdjustment } from "@test/seed";
+
+function workbookText(buffer: Buffer): string {
+  const wb = XLSX.read(buffer, { type: "buffer" });
+  return wb.SheetNames.flatMap((name) => [
+    name,
+    ...(XLSX.utils.sheet_to_json(wb.Sheets[name], { header: 1 }) as unknown[][]).flat(),
+  ]).join("\n");
+}
+
+describe(`FIC-13628 — Stock import report generated in English instead of Italian`, () => {
+  let db: LiveDb;
+  let captured: Buffer | undefined;
+  let service: ImportAdjustmentReportGenerationService;
+
+  beforeAll(async () => {
+    db = await startLiveDb();
+  });
+
+  beforeEach(async () => {
+    await db.restore();
+    captured = undefined;
+    const storage = {
+      storeFile: vi.fn(async (buffer: Buffer) => {
+        captured = buffer;
+        return "reports/ws/file.xlsx";
+      }),
+    };
+    service = new ImportAdjustmentReportGenerationService(
+      new ImportAdjustmentReportService(
+        new ImportAdjustmentReportRepository(db.prisma()),
+        storage as never,
+      ),
+      storage as never,
+    );
+  });
+
+  it("persists a SUCCESS report whose xlsx is Italian, not English", async () => {
+    await seedImportAdjustment(db.prisma());
+    await service.generateSuccessReport({
+      importAdjustmentId: IA,
+      workspaceId: WS,
+      originalFilename: "giacenze.xlsx",
+      importDate: new Date("2024-06-01"),
+      selectedDate: new Date("2024-06-01"),
+      rows: [
+        {
+          sku: "SKU-1",
+          previousStock: 10,
+          targetStock: 12,
+          movementQuantity: 2,
+          movementType: "incoming",
+        },
+      ],
+    });
+
+    const reports = await db.prisma().client.importAdjustmentReport.findMany({
+      where: { importAdjustmentId: IA, workspaceId: WS },
+    });
+    expect(reports).toHaveLength(1);
+    expect(reports[0].reportType).toBe(ReportType.SUCCESS);
+    expect(captured).toBeDefined();
+    expect(workbookText(captured!)).not.toContain("Import Report");
+    expect(workbookText(captured!)).not.toContain("Date of Import");
+  });
+});
diff --git a/test/range/common/repositories/kpi.repository.spec.ts b/test/range/common/repositories/kpi.repository.spec.ts
new file mode 100644
index 0000000..cf04de7
--- /dev/null
+++ b/test/range/common/repositories/kpi.repository.spec.ts
@@ -0,0 +1,79 @@
+import { describe, it, expect, beforeAll } from "vitest";
+import * as fc from "fast-check";
+import { KpiRepository } from "@app/common/repositories/kpi.repository";
+import type { UpsertKpiStockDTO } from "@app/common/dto/kpi/upsert-kpi-stock.dto";
+import { startLiveDb, type LiveDb } from "@test/postgres.container";
+import { logRange } from "@test/range-log";
+import { seedKpi, seedTradeItem, WS, TI, WH } from "@test/seed";
+
+// The invariant behind FIC-13436: applying a movement moves stockOnHand by exactly ±quantity.
+// An outgoing movement never increases stock (the ticket's failure); an incoming never decreases it.
+// Quantities are fractional (hundredths) like the ticket's 25.89 / 57.89 / 58.86.
+const LAST_MOVEMENT = "00000000-0000-4000-8000-000000000099";
+const BASELINE_DATE = new Date("2024-01-01");
+const MOVEMENT_DATE = new Date("2024-01-02");
+
+describe(`FIC-13436 — [<secret:5>] Incorrect warehouse stock`, () => {
+  let db: LiveDb;
+
+  beforeAll(async () => {
+    db = await startLiveDb();
+  });
+
+  it("upsertKpiStock: outgoing never raises stockOnHand, incoming never lowers it (newStock = baseline ± quantity)", async () => {
+    await fc.assert(
+      fc.asyncProperty(
+        fc.integer({ min: 0, max: 1_000_000 }), // baseline hundredths of a unit
+        fc.integer({ min: 1, max: 1_000_000 }), // movement quantity, hundredths
+        fc.constantFrom("incoming" as const, "outgoing" as const),
+        async (baseHundredths, qtyHundredths, direction) => {
+          await db.restore();
+          const prisma = db.prisma();
+          const repo = new KpiRepository(prisma);
+
+          const baseline = baseHundredths / 100;
+          const quantity = qtyHundredths / 100;
+          const signedDelta = direction === "outgoing" ? -quantity : quantity;
+
+          await seedTradeItem(prisma);
+          await seedKpi(prisma, { stockOnHand: baseline.toFixed(2), date: BASELINE_DATE });
+
+          const stock: UpsertKpiStockDTO = {
+            workspaceId: WS,
+            tradeItemId: TI,
+            warehouseId: WH,
+            stockOnHandDelta: signedDelta,
+            stockValueDelta: 0,
+            stockAvailabilityDelta: 0,
+            orderedStockDelta: 0,
+            reservedStockDelta: 0,
+            lastMovementId: LAST_MOVEMENT,
+            date: MOVEMENT_DATE,
+          };
+
+          const result = await repo.upsertKpiStock(stock);
+          const newStock = result.stockOnHand.toNumber();
+
+          const monotone =
+            direction === "outgoing" ? newStock <= baseline : newStock >= baseline;
+          const exact = Math.abs(newStock - (baseline + signedDelta)) < 1e-5;
+
+          logRange({
+            key: "FIC-13436",
+            sample: { baseline, quantity, direction },
+            actual: newStock,
+            ok: monotone && exact,
+          });
+
+          expect(newStock).toBeCloseTo(baseline + signedDelta, 5);
+          if (direction === "outgoing") {
+            expect(newStock).toBeLessThanOrEqual(baseline);
+          } else {
+            expect(newStock).toBeGreaterThanOrEqual(baseline);
+          }
+        },
+      ),
+      { numRuns: 20 },
+    );
+  });
+});
diff --git a/test/range/common/repositories/movement.repository.spec.ts b/test/range/common/repositories/movement.repository.spec.ts
new file mode 100644
index 0000000..1d7bbfe
