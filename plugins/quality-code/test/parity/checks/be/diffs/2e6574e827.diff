+
+function workbookText(buffer: Buffer): string {
+  const wb = XLSX.read(buffer, { type: "buffer" });
+  return wb.SheetNames.flatMap((name) => [
+    name,
+    ...(XLSX.utils.sheet_to_json(wb.Sheets[name], { header: 1 }) as unknown[][]).flat(),
+  ]).join("\n");
+}
+
+describe(`FIC-13628 — Stock import report generated in English instead of Italian`, () => {
+  let db: LiveDb;
+
+  beforeAll(async () => {
+    db = await startLiveDb();
+  });
+
+  it("success report never contains English chrome for any filename", async () => {
+    await fc.assert(
+      fc.asyncProperty(fc.integer({ min: 1, max: 999 }), async (n) => {
+          await db.restore();
+          let captured: Buffer | undefined;
+          const service = new ImportAdjustmentReportGenerationService(
+            { createReport: vi.fn().mockResolvedValue({ id: "r1" }) } as never,
+            {
+              storeFile: vi.fn(async (buffer: Buffer) => {
+                captured = buffer;
+                return "reports/ws/file.xlsx";
+              }),
+            } as never,
+          );
+          await service.generateSuccessReport({
+            importAdjustmentId: IA,
+            workspaceId: WS,
+            originalFilename: `giacenze-${n}.xlsx`,
+            importDate: new Date("2024-06-01"),
+            selectedDate: new Date("2024-06-01"),
+            rows: [
+              {
+                sku: `SKU-${n}`,
+                previousStock: 1,
+                targetStock: 2,
+                movementQuantity: 1,
+                movementType: "incoming",
+              },
+            ],
+          });
+          expect(captured).toBeDefined();
+          expect(workbookText(captured!)).not.toContain("Import Report");
+        },
+      ),
+      { numRuns: 20 },
+    );
+  });
+});
diff --git a/test/unit/common/repositories/kpi.repository.spec.ts b/test/unit/common/repositories/kpi.repository.spec.ts
new file mode 100644
index 0000000..90092da
--- /dev/null
+++ b/test/unit/common/repositories/kpi.repository.spec.ts
@@ -0,0 +1,81 @@
+import { describe, it, expect, beforeAll, beforeEach } from "vitest";
+import { KpiRepository } from "@app/common/repositories/kpi.repository";
+import type { UpsertKpiStockDTO } from "@app/common/dto/kpi/upsert-kpi-stock.dto";
+import { startLiveDb, type LiveDb } from "@test/postgres.container";
+import { seedKpi, seedTradeItem, WS, TI, WH } from "@test/seed";
+
+// Ticket exhibit (product ORO ROSA 9KT): initial 32, +25.89 (load), -57.89 (active doc),
+// +58.86 (load) must reconstruct to 58.86. The reported 116.75 is 32 + 25.89 + 58.86 —
+// the outgoing -57.89 was never subtracted. This pins the running stockOnHand accumulation.
+const LAST_MOVEMENT = "00000000-0000-4000-8000-000000000099";
+
+function mkStock(stockOnHandDelta: number, date: Date): UpsertKpiStockDTO {
+  return {
+    workspaceId: WS,
+    tradeItemId: TI,
+    warehouseId: WH,
+    stockOnHandDelta,
+    stockValueDelta: 0,
+    stockAvailabilityDelta: 0,
+    orderedStockDelta: 0,
+    reservedStockDelta: 0,
+    lastMovementId: LAST_MOVEMENT,
+    date,
+  };
+}
+
+describe(`FIC-13436 — [<secret:5>] Incorrect warehouse stock`, () => {
+  let db: LiveDb;
+  let repo: KpiRepository;
+
+  beforeAll(async () => {
+    db = await startLiveDb();
+  });
+
+  beforeEach(async () => {
+    await db.restore();
+    repo = new KpiRepository(db.prisma());
+  });
+
+  // Regression anchor: replay the ticket's movement history through the real accumulation.
+  // Buggy behaviour (outgoing ignored) lands the final row on 116.75; correct behaviour on 58.86.
+  it("upsertKpiStock: outgoing delta subtracts, so 32 +25.89 -57.89 +58.86 = 58.86 (not 116.75)", async () => {
+    const prisma = db.prisma();
+    await seedTradeItem(prisma);
+    // Opening balance: initial quantity 32
+    await seedKpi(prisma, { stockOnHand: "32", date: new Date("2024-01-01") });
+
+    const afterLoad1 = await repo.upsertKpiStock(
+      mkStock(25.89, new Date("2024-01-02")),
+    );
+    expect(afterLoad1.stockOnHand.toNumber()).toBeCloseTo(57.89, 2);
+
+    // The outgoing active document (-57.89) must DECREASE stock, not be dropped or added.
+    const afterOutgoing = await repo.upsertKpiStock(
+      mkStock(-57.89, new Date("2024-01-03")),
+    );
+    expect(afterOutgoing.stockOnHand.toNumber()).toBeCloseTo(0, 5);
+    expect(afterOutgoing.stockOnHand.toNumber()).toBeLessThan(57.89);
+
+    const afterLoad2 = await repo.upsertKpiStock(
+      mkStock(58.86, new Date("2024-01-04")),
+    );
+    expect(afterLoad2.stockOnHand.toNumber()).toBeCloseTo(58.86, 2);
+    // Explicitly reject the reported (buggy) value.
+    expect(afterLoad2.stockOnHand.toNumber()).not.toBeCloseTo(116.75, 2);
+  });
+
+  // The invariant in isolation: an outgoing delta is (previous - quantity), independent of sign.
+  it("edge: outgoing delta subtracts even when it drives stock below zero", async () => {
+    const prisma = db.prisma();
+    await seedTradeItem(prisma);
+    await seedKpi(prisma, { stockOnHand: "10", date: new Date("2024-01-01") });
+
+    const after = await repo.upsertKpiStock(
+      mkStock(-57.89, new Date("2024-01-02")),
+    );
+
+    expect(after.stockOnHand.toNumber()).toBeCloseTo(-47.89, 2);
+    expect(after.stockOnHand.toNumber()).toBeLessThan(10);
+  });
+});
diff --git a/test/unit/common/repositories/movement.repository.spec.ts b/test/unit/common/repositories/movement.repository.spec.ts
