+import { describe, it, expect, beforeAll, beforeEach } from "vitest";
+import { TradeItemRepository } from "@app/common/repositories/trade-item.repository";
+import { startLiveDb, type LiveDb } from "@test/postgres.container";
+import { seedTradeItem, TI, WS } from "@test/seed";
+
+describe("TradeItemRepository (db unit)", () => {
+  let db: LiveDb;
+  let repo: TradeItemRepository;
+
+  beforeAll(async () => {
+    db = await startLiveDb();
+  });
+
+  beforeEach(async () => {
+    await db.restore();
+    repo = new TradeItemRepository(db.prisma());
+  });
+
+  it("findByCode returns the seeded row", async () => {
+    await seedTradeItem(db.prisma(), {
+      code: "CODE-1",
+      unitCost: "80",
+      unitPrice: "150",
+    });
+    const found = await repo.findByCode({ code: "CODE-1", workspaceId: WS });
+    expect(found).not.toBeNull();
+    expect(found?.code).toBe("CODE-1");
+    expect(found?.unitCost?.toString()).toBe("80");
+    expect(found?.deletedAt).toBeNull();
+  });
+
+  it("findByCode skips a soft-deleted row", async () => {
+    await seedTradeItem(db.prisma(), {
+      code: "GONE",
+      deletedAt: new Date("2024-01-01"),
+    });
+    expect(await repo.findByCode({ code: "GONE", workspaceId: WS })).toBeNull();
+  });
+});
+
+describe(`FIC-13441 — KPI "Unit cost from master data" shows unit_price instead of unit_cost`, () => {
+  let db: LiveDb;
+  let repo: TradeItemRepository;
+
+  beforeAll(async () => {
+    db = await startLiveDb();
+  });
+
+  beforeEach(async () => {
+    await db.restore();
+    repo = new TradeItemRepository(db.prisma());
+  });
+
+  // Scenario: KPI reads unit_cost, not unit_price
+  //   Given a product with unit_cost = 80 and unit_price = 150 in master data
+  //   When the item is read
+  //   Then unitCost is 80, never 150
+  it("get returns unitCost from unit_cost, not unit_price", async () => {
+    await seedTradeItem(db.prisma(), { unitCost: "80", unitPrice: "150" });
+    const item = await repo.get({ id: TI, workspaceId: WS }, false);
+    expect(item.unitCost?.toString()).toBe("80");
+    expect(item.unitCost?.toString()).not.toBe("150");
+    expect(item.unitPrice?.toString()).toBe("150");
+    expect(item.deletedAt).toBeNull();
+  });
+
+  it("edge: null unit_cost does not leak unit_price into unitCost", async () => {
+    await seedTradeItem(db.prisma(), { unitCost: null, unitPrice: "150" });
+    const item = await repo.get({ id: TI, workspaceId: WS }, false);
+    expect(item.unitCost).toBeNull();
+    expect(item.unitPrice?.toString()).toBe("150");
+  });
+
+  it("edge: equal unit_cost and unit_price still map to their own columns", async () => {
+    await seedTradeItem(db.prisma(), { unitCost: "100", unitPrice: "100" });
+    const item = await repo.get({ id: TI, workspaceId: WS }, false);
+    expect(item.unitCost?.toString()).toBe("100");
+    expect(item.unitPrice?.toString()).toBe("100");
+  });
+
+  it("edge: findAll excludes a soft-deleted product", async () => {
+    await seedTradeItem(db.prisma(), {
+      unitCost: "80",
+      unitPrice: "150",
+      deletedAt: new Date("2024-01-01"),
+    });
+    const result = await repo.findAllByWorkspace(WS);
+    expect(result).toHaveLength(0);
+  });
+
+  it.todo(
+    "sibling KPIs on the products dashboard are unchanged — needs product-owned fixtures",
+  );
+});
