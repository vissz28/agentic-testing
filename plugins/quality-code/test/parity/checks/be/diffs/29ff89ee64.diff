+// FIC-13860 invariant: a provided cost/price is what getLastUnitCost/getLastUnitPrice returns —
+// for EVERY value including 0, and independent of whatever the last KPI row holds. The defect
+// (`if (cost)`) only returns the provided value when it is truthy, so any generated 0 falls back
+// to the seeded last_cost/last_price and fails the property.
+describe(`FIC-13860 — [BE] KPI "last unit cost" drops a zero-cost movement — kpi.repository`, () => {
+  let db: LiveDb;
+  const kpiData: GetKPIDTO = { workspaceId: WS, tradeItemId: TI, warehouseId: WH };
+
+  beforeAll(async () => {
+    db = await startLiveDb();
+  });
+
+  it("getLastUnitCost: the provided cost (0..1e6 incl. 0) is returned verbatim, never the seeded last_cost", async () => {
+    await fc.assert(
+      fc.asyncProperty(
+        // 0 is the whole point of the bug — sample it as often as any other value, not by luck.
+        fc.oneof(fc.constant(0), fc.integer({ min: 0, max: 100_000_000 })), // provided cost, hundredths of a currency unit
+        fc.integer({ min: 1, max: 100_000_000 }), // seeded last_cost, hundredths (always > 0 to prove it is not the source)
+        async (costHundredths, seededHundredths) => {
+          await db.restore();
+          const prisma = db.prisma();
+          const repo = new KpiRepository(prisma);
+
+          const cost = costHundredths / 100;
+          const seededLastCost = seededHundredths / 100;
+
+          await seedTradeItem(prisma);
+          await seedKpi(prisma, { lastCost: seededLastCost.toFixed(2) });
+
+          const result = await repo.getLastUnitCost(kpiData, cost);
+
+          logRange({
+            key: "FIC-13860",
+            sample: { cost, seededLastCost, method: "getLastUnitCost" },
+            actual: result,
+            ok: result === cost,
+          });
+
+          expect(result).toBe(cost);
+        },
+      ),
+      { numRuns: 20 },
+    );
+  });
+
+  it("getLastUnitPrice: the provided price (0..1e6 incl. 0) is returned verbatim, never the seeded last_price", async () => {
+    await fc.assert(
+      fc.asyncProperty(
+        fc.oneof(fc.constant(0), fc.integer({ min: 0, max: 100_000_000 })),
+        fc.integer({ min: 1, max: 100_000_000 }),
+        async (priceHundredths, seededHundredths) => {
+          await db.restore();
+          const prisma = db.prisma();
+          const repo = new KpiRepository(prisma);
+
+          const price = priceHundredths / 100;
+          const seededLastPrice = seededHundredths / 100;
+
+          await seedTradeItem(prisma);
+          await seedKpi(prisma, { lastPrice: seededLastPrice.toFixed(2) });
+
+          const result = await repo.getLastUnitPrice(kpiData, price);
+
+          logRange({
+            key: "FIC-13860",
+            sample: { price, seededLastPrice, method: "getLastUnitPrice" },
+            actual: result,
+            ok: result === price,
+          });
+
+          expect(result).toBe(price);
+        },
+      ),
+      { numRuns: 20 },
+    );
+  });
+});
