-  beforeAll(async () => {
-    db = await startLiveDb();
-  });
-
-  it("upsertKpiStock: outgoing never raises stockOnHand, incoming never lowers it (newStock = baseline ± quantity)", async () => {
-    await fc.assert(
-      fc.asyncProperty(
-        fc.integer({ min: 0, max: 1_000_000 }), // baseline hundredths of a unit
-        fc.integer({ min: 1, max: 1_000_000 }), // movement quantity, hundredths
-        fc.constantFrom("incoming" as const, "outgoing" as const),
-        async (baseHundredths, qtyHundredths, direction) => {
-          await db.restore();
-          const prisma = db.prisma();
-          const repo = new KpiRepository(prisma);
-
-          const baseline = baseHundredths / 100;
-          const quantity = qtyHundredths / 100;
-          const signedDelta = direction === "outgoing" ? -quantity : quantity;
-
-          await seedTradeItem(prisma);
-          await seedKpi(prisma, { stockOnHand: baseline.toFixed(2), date: BASELINE_DATE });
-
-          const stock: UpsertKpiStockDTO = {
-            workspaceId: WS,
-            tradeItemId: TI,
-            warehouseId: WH,
-            stockOnHandDelta: signedDelta,
-            stockValueDelta: 0,
-            stockAvailabilityDelta: 0,
-            orderedStockDelta: 0,
-            reservedStockDelta: 0,
-            lastMovementId: LAST_MOVEMENT,
-            date: MOVEMENT_DATE,
-          };
-
-          const result = await repo.upsertKpiStock(stock);
-          const newStock = result.stockOnHand.toNumber();
-
-          const monotone =
-            direction === "outgoing" ? newStock <= baseline : newStock >= baseline;
-          const exact = Math.abs(newStock - (baseline + signedDelta)) < 1e-5;
-
-          logRange({
-            key: "FIC-13436",
-            sample: { baseline, quantity, direction },
-            actual: newStock,
-            ok: monotone && exact,
-          });
-
-          expect(newStock).toBeCloseTo(baseline + signedDelta, 5);
-          if (direction === "outgoing") {
-            expect(newStock).toBeLessThanOrEqual(baseline);
-          } else {
-            expect(newStock).toBeGreaterThanOrEqual(baseline);
-          }
-        },
-      ),
-      { numRuns: 20 },
-    );
-  });
-});
