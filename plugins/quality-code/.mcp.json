{
  "mcpServers": {
    "atlassian-rovo": { "type": "http", "url": "https://mcp.atlassian.com/v1/mcp" },
    "figma": { "type": "http", "url": "https://mcp.figma.com/mcp" },
    "figma-token": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/mcp-launch.mjs", "figma-token", "--", "npx", "-y", "figma-developer-mcp@0.13.2", "--stdio"],
      "env": { "FIGMA_API_KEY": "${user_config.figma_api_key}" }
    },
    "gitlab": { "type": "http", "url": "${user_config.gitlab_api_url}/mcp" },
    "gitlab-token": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/mcp-launch.mjs", "gitlab-token", "--", "npx", "-y", "@zereight/mcp-gitlab@2.2.5"],
      "env": {
        "GITLAB_API_URL": "${user_config.gitlab_api_url}",
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${user_config.gitlab_token}",
        "GITLAB_PERMISSION_MODE": "readonly"
      }
    }
  }
}
